// Data source
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generator
generator client {
  provider = "prisma-client-js"
}

// Models

model User {
  id        Int      @id @default(autoincrement())
  fullname  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts        Post[]
  profile      Profile?
  transactions Transaction[]
  instruments  Instrument[]  @relation("InstrumentUsers")
}

model Profile {
  id  Int     @id @default(autoincrement())
  bio String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int?
  user   User?      @relation(fields: [userId], references: [id])
  tags   PostTags[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts PostTags[]
}

model PostTags {
  postId    Int
  tagId     Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Instrument {
  id           Int      @id @default(autoincrement())
  type         String
  purchaseDate DateTime

  users User[] @relation("InstrumentUsers")
}
